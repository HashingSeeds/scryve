{
  "name": "scryve",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@expo/ui"
        ]
      }
    }
  },
  "packageManager": "pnpm@10.34.5",
  "config": {
    "easCli": "24.12.1"
  },
  "scripts": {
    "start": "node scripts/dev.cjs",
    "start:expo": "APP_VARIANT=development npx expo start --dev-client --scheme scryve-dev",
    "android": "env APP_VARIANT=development npx expo run:android",
    "ios": "env APP_VARIANT=development npx expo run:ios",
    "web": "env APP_VARIANT=development npx expo start --web",
    "site:dev": "pnpm --filter scryve-site dev",
    "site:build": "pnpm --filter scryve-site build",
    "bundle:web": "set -a && . ./.env.development && set +a && env APP_VARIANT=development SCRYVE_WEB_BASE_URL=/play npx expo export --platform web --clear --output-dir dist/play",
    "bundle:web:prod": "set -a && . ./.env.local && . ./.env.production && set +a && env APP_VARIANT=production EXPO_PUBLIC_SENTRY_ENVIRONMENT=production SCRYVE_WEB_BASE_URL=/play npx expo export --platform web --clear --output-dir dist/play",
    "build:web:pages": "pnpm site:build && APP_VARIANT=production SCRYVE_WEB_BASE_URL=/play EXPO_PUBLIC_SENTRY_ENVIRONMENT=$([ \"${CF_PAGES_BRANCH:-production}\" = production ] && echo production || echo development) npx expo export --platform web --clear --output-dir dist/play && node scripts/prepare-web-deploy.cjs",
    "build:pages": "node scripts/pages-build.cjs",
    "convex:dev": "convex dev",
    "bots": "node scripts/bots.cjs",
    "preview:up": "node scripts/preview.cjs up",
    "preview:check": "node scripts/preview.cjs check",
    "prebuild:clean": "expo prebuild --clean",
    "compile": "pnpm run compile:app && pnpm run compile:test",
    "compile:app": "tsc --noEmit -p . --pretty --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo",
    "compile:test": "tsc --noEmit -p test/test-tsconfig.json --pretty --incremental --tsBuildInfoFile node_modules/.cache/tsc/test.tsbuildinfo",
    "lint": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:check": "sh scripts/lint-check.sh",
    "export:check": "expo export --platform ios --platform android --platform web --output-dir dist-export-check",
    "lint:comments:baseline": "node scripts/generate-comment-baseline.cjs",
    "comments:apply": "node scripts/comment-review.cjs apply",
    "deps:check": "depcruise src convex --config .dependency-cruiser.js",
    "deps:graph": "depcruise src convex --include-only \"^(src|convex)\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "expo install --fix",
    "test": "jest",
    "test:scripts": "node --test scripts/*.test.cjs",
    "i18n:translate": "node scripts/i18n.cjs translate",
    "i18n:check": "node scripts/i18n.cjs check",
    "test:watch": "jest --watch",
    "test:ygo-worker": "jest workers/ygo-image-mirror/src/index.test.ts workers/ygo-image-mirror/sync/index.test.ts --runInBand && vitest run --config workers/ygo-image-mirror/vitest.config.mts",
    "check:ygo-worker": "wrangler types --check --cwd workers/ygo-image-mirror && tsc --noEmit -p workers/ygo-image-mirror/tsconfig.json && tsc --noEmit -p workers/ygo-image-mirror/sync/tsconfig.json && tsc --noEmit -p workers/ygo-image-mirror/test/tsconfig.json && pnpm test:ygo-worker && wrangler deploy --dry-run --cwd workers/ygo-image-mirror --env= --outdir .wrangler/dry-run-preview && wrangler deploy --dry-run --cwd workers/ygo-image-mirror --env production --outdir .wrangler/dry-run-production",
    "sync:ygo-images": "tsx workers/ygo-image-mirror/sync/index.ts",
    "app-icons": "tsx scripts/app-icons.ts",
    "e2e": "bash scripts/maestro-run.sh",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.sowinghope.count --exclude-tags unconfigured .maestro/flows",
    "test:maestro:smoke": "maestro test -e MAESTRO_APP_ID=com.sowinghope.count --include-tags smoke .maestro/flows",
    "test:maestro:check": "jest test/maestroSelectors.test.ts --runInBand",
    "capture:apple-review": "MAESTRO_APP_ID=com.sowinghope.count maestro test .maestro/store-assets/CaptureAppleReview.yaml",
    "adb": "adb reverse tcp:8081 tcp:8081",
    "ios:development:sim": "node scripts/native.cjs ios:development:sim",
    "ios:development": "node scripts/native.cjs ios:development",
    "ios:preview": "node scripts/native.cjs ios:preview",
    "ios:production": "node scripts/native.cjs ios:production",
    "ios:profile": "node scripts/native.cjs ios:profile",
    "android:development": "node scripts/native.cjs android:development",
    "android:preview": "node scripts/native.cjs android:preview",
    "android:production": "node scripts/native.cjs android:production",
    "ota:preview": "env APP_VARIANT=preview npx eas-cli@$npm_package_config_easCli update --channel preview --environment preview",
    "release:promote": "node scripts/release-train.cjs promote",
    "release:native": "node scripts/release-native.cjs cloud",
    "release:live": "node scripts/release-native.cjs live"
  },
  "dependencies": {
    "@clerk/expo": "4.14.1",
    "@clerk/expo-native-components": "0.4.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@legendapp/state": "3.0.0-beta.48",
    "@sentry/react-native": "~8.28.0",
    "buffer": "5.7.1",
    "convex": "1.42.3",
    "expo": "58.0.19",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-application": "~58.1.2",
    "expo-auth-session": "58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-observe": "~58.0.16",
    "expo-router": "~58.0.26",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "58.0.6",
    "fflate": "^0.8.3",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "obscenity": "^0.4.6",
    "posthog-react-native": "^4.67.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.88.0",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "3.3.3",
    "react-native-purchases": "^10.15.1",
    "react-native-purchases-ui": "^10.15.1",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "6.4.3",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-native-zeroconf": "1.0.0-rc.2",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@babel/runtime": "^7.20.0",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "babel-jest": "^30.5.2",
    "convex-test": "0.0.54",
    "dependency-cruiser": "^17.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-reactotron": "^0.1.2",
    "eslint-plugin-self-explanatory-code": "file:tools/eslint-plugin-self-explanatory-code",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.3.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": "24.18.1",
    "pnpm": "10.34.5"
  }
}

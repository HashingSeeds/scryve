{
  "name": "count",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "start": "concurrently --kill-others \"pnpm start:expo\" \"pnpm convex:dev\"",
    "start:expo": "APP_VARIANT=development npx expo start --dev-client",
    "android": "APP_VARIANT=development npx expo run:android",
    "ios": "APP_VARIANT=development npx expo run:ios",
    "web": "npx expo start --web",
    "bundle:web": "npx expo export --platform web",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "prebuild:clean": "expo prebuild --clean",
    "compile": "pnpm run compile:app && pnpm run compile:test",
    "compile:app": "tsc --noEmit -p . --pretty",
    "compile:test": "tsc --noEmit -p test/test-tsconfig.json --pretty",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:comments:baseline": "node scripts/generate-comment-baseline.cjs",
    "depcruise": "depcruise src convex --config .dependency-cruiser.js",
    "depcruise:graph": "depcruise src convex --include-only \"^(src|convex)\" --config .dependency-cruiser.js --output-type dot > app-dependency-graph.dot && dot -T svg app-dependency-graph.dot -o app-dependency-graph.svg && dot -T png app-dependency-graph.dot -o app-dependency-graph.png && rm app-dependency-graph.dot",
    "align-deps": "expo install --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:maestro": "maestro test -e MAESTRO_APP_ID=com.sowinghope.count .maestro/flows",
    "test:maestro:smoke": "maestro test -e MAESTRO_APP_ID=com.sowinghope.count .maestro/flows/Landing.yaml",
    "test:maestro:check": "jest test/maestroSelectors.test.ts --runInBand",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "build:ios:sim": "npx eas-cli@latest build --profile development --platform ios --local",
    "build:ios:dev": "npx eas-cli@latest build --profile development:device --platform ios --local",
    "build:ios:preview": "set -a && . ./.env.local && set +a && npx eas-cli@latest build --profile preview --platform ios --local",
    "build:ios:prod": "set -a && . ./.env.local && set +a && npx eas-cli@latest build --profile production --platform ios --local",
    "build:android:sim": "npx eas-cli@latest build --profile development --platform android --local",
    "build:android:dev": "npx eas-cli@latest build --profile development:device --platform android --local",
    "build:android:preview": "set -a && . ./.env.local && set +a && npx eas-cli@latest build --profile preview --platform android --local",
    "build:android:prod": "set -a && . ./.env.local && set +a && npx eas-cli@latest build --profile production --platform android --local"
  },
  "dependencies": {
    "@clerk/expo": "3.7.3",
    "@expo-google-fonts/space-grotesk": "^0.4.0",
    "@expo/metro-runtime": "~55.0.6",
    "@sentry/react-native": "^8.22.0",
    "convex": "1.42.3",
    "date-fns": "^4.1.0",
    "expo": "55.0.5",
    "expo-apple-authentication": "55.0.14",
    "expo-auth-session": "55.0.17",
    "expo-build-properties": "~55.0.9",
    "expo-camera": "~55.0.21",
    "expo-constants": "55.0.16",
    "expo-crypto": "55.0.16",
    "expo-dev-client": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.15",
    "expo-image": "~55.0.11",
    "expo-keep-awake": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-local-authentication": "55.0.15",
    "expo-localization": "~55.0.8",
    "expo-router": "~55.0.4",
    "expo-secure-store": "55.0.15",
    "expo-splash-screen": "~55.0.10",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~55.0.26",
    "expo-web-browser": "55.0.17",
    "i18next": "^23.14.0",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.83.2",
    "react-native-edge-to-edge": "~1.6.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "3.3.3",
    "react-native-purchases": "^10.7.0",
    "react-native-purchases-ui": "^10.7.0",
    "react-native-qrcode-svg": "6.3.21",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "setimmediate": "^1.0.5",
    "svix": "^1.99.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "20.19.43",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.2.1",
    "concurrently": "^9.2.4",
    "convex-test": "0.0.54",
    "dependency-cruiser": "^17.0.2",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-reactotron": "^0.1.2",
    "eslint-plugin-self-explanatory-code": "file:tools/eslint-plugin-self-explanatory-code",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.0",
    "reactotron-core-client": "^2.9.4",
    "reactotron-react-js": "^3.3.11",
    "reactotron-react-native": "^5.0.5",
    "reactotron-react-native-mmkv": "^0.2.6",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "24.18.1",
    "pnpm": "10.14.0"
  }
}

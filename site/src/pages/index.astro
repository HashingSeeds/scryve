---
import qrcode from "qrcode"

import appIcon from "../../../assets/images/app-icon-ios.png?url"
import GetTheApp from "../components/GetTheApp.astro"
import Base from "../layouts/Base.astro"
import { APP_LINKS } from "../links"
import { demoCards } from "../stage/deck-demo"

const qr = await qrcode.toString(new URL("/", Astro.site).href, {
  type: "svg",
  margin: 2,
  color: { dark: "#000000", light: "#ffffff" },
})

const versions = [
  { name: "Current", record: "6–1" },
  { name: "Proliferate package", record: "5–3–1" },
  { name: "Budget swap", record: "3–5" },
]
const plans = [
  ["Life counter for 2 to 6 players", "Yes", "Yes"],
  ["Connected play", "Yes", "Yes"],
  ["Game history", "Yes", "Yes"],
  ["Decks", "2", "100"],
  ["Deck versioning", "No", "Up to 5 versions"],
  ["Win rate by deck and version", "No", "Yes"],
]
---

<Base
  title="Scryve: life counter and deck tracker for Magic, Yu-Gi-Oh!, and Pokémon"
  description="A fast life counter for 2 to 6 players with commander damage, connected games across phones, and deck tracking. Works offline. Play in your browser or on iPhone and Android."
>
  <header class="header">
    <a class="brand" href="/"><img src={appIcon} alt="" width="30" height="30" />Scryve</a>
    <nav class="header-nav" aria-label="Sections">
      <a href="#features">Features</a>
      <a href="#connected">Connected play</a>
      <a href="#pro">Pro</a>
    </nav>
    <div class="header-actions">
      <a class="quiet" href={APP_LINKS.account}>Sign in</a>
      <a class="button small" href={APP_LINKS.play}>Play in browser</a>
    </div>
  </header>

  <main>
    <div class="landing">
      <section class="hero" aria-label="Live life counter">
        <div class="hero-slot" data-hero-slot></div>
      </section>
      <div class="hero-foot">
        <h1>The life counter for Magic, Yu-Gi-Oh!, and Pokémon. <span>Tap to change a total. Really, you try. <svg class="smiley" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M8 14.5c1 1.4 2.4 2 4 2s3-.6 4-2" /><circle class="eye" cx="9" cy="9.5" r="1.2" /><circle class="eye" cx="15" cy="9.5" r="1.2" /></svg></span></h1>
        <GetTheApp play={false} />
      </div>
    </div>

    <div class="tour">
      <div class="steps">
        <section data-scene="intro" aria-label="Platforms">
          <div class="step" data-step="intro">
            <div class="step-copy">
              <h2>On the table in seconds.</h2>
              <p>Open Scryve in your browser, or install it on iPhone, iPad, or Android. Local games work offline with no account.</p>
            </div>
          </div>
        </section>

        <section id="features" data-scene="features" aria-label="Features">
          <div class="step" data-step="players">
            <div class="step-copy">
              <h2>Two to six players.</h2>
              <p>Pick the layout that matches how you sit.</p>
              <div class="picker" data-pick="count" role="group" aria-label="Players">
                {[2, 3, 4, 5, 6].map((count) => (
                  <button type="button" data-value={count} aria-pressed={String(count === 5)}>{count}</button>
                ))}
              </div>
              <div class="picker" data-pick="layout" role="group" aria-label="Layout"></div>
            </div>
          </div>
          <div class="step" data-step="commander">
            <div class="step-copy">
              <h2>Commander damage, per opponent.</h2>
              <p>Every seat tracks damage from each commander at the table. At 21 from one commander, that player is out.</p>
              <button class="demo-replay" type="button" data-commander-replay>Replay demo</button>
            </div>
          </div>
          <div class="step" data-step="systems">
            <div class="step-copy">
              <h2>Magic, Yu-Gi-Oh!, and Pokémon.</h2>
              <p>Life, Life Points, or prize cards, with each game's formats built in.</p>
              <div class="picker" data-pick="system" role="group" aria-label="Game"></div>
            </div>
          </div>
        </section>

        <section id="connected" data-scene="connected" aria-label="Connected play">
          <div class="step" data-step="join">
            <div class="step-copy">
              <h2>One game, every phone.</h2>
              <p>Players join from their own phones with a six-character code, a QR code, or a link. Tap either phone.</p>
            </div>
          </div>
          <div class="step" data-step="seats">
            <div class="step-copy">
              <h2>Seats, colors, and marks.</h2>
              <p>Everyone signs in, then picks a seat, a color, and a mark before the host starts the game.</p>
            </div>
          </div>
        </section>

        <section id="pro" data-scene="pro" aria-label="Decks and Scryve Pro">
          <div class="step" data-step="decks">
            <div class="step-copy">
              <h2>Decks that keep score.</h2>
              <p>Tap a card to see its details. Tap ••• to compare version records with Pro.</p>
            </div>
          </div>
          <div class="step" data-step="plans">
            <div class="step-copy">
              <h2>Free or Pro</h2>
              <table class="plans">
                <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">Free</th><th scope="col">Scryve Pro</th></tr></thead>
                <tbody>
                  {plans.map(([feature, free, pro]) => (
                    <tr><th scope="row">{feature}</th><td>{free}</td><td>{pro}</td></tr>
                  ))}
                </tbody>
              </table>
              <p class="note">Pro is monthly or yearly. Upgrade from Account in the app.</p>
            </div>
          </div>
        </section>
      </div>

      <div class="stage" data-stage data-scene="intro" data-step="intro">
        <div class="rig">
          <div class="phone main">
            <div class="screen">
              <div class="scene-screen" data-for="intro features">
                <div class="board-holder" data-board="features"></div>
              </div>
              <div class="scene-screen" data-for="connected"><div class="board-holder" data-board="connected"></div></div>
              <div class="scene-screen deck" data-for="pro">
                <div class="deck-top"><span>Back</span><b>Deck</b><span>Edit</span></div>
                <div class="deck-content">
                  <div class="deck-name">Atraxa Counters</div>
                  <div class="deck-meta">Magic · Commander · 100 cards</div>
                  <div class="deck-tabs" role="group" aria-label="Deck view">
                    <button type="button" data-deck-tab="cards" aria-pressed="true">Cards</button>
                    <button type="button" data-deck-tab="notes" aria-pressed="false">Notes</button>
                  </div>
                  <div data-deck-panel="cards">
                    <div class="deck-label">Commander <em>Change</em></div>
                    {demoCards.map((card, index) => (
                      <Fragment>
                        {index === 1 && <div class="deck-label">Main deck <em>99</em></div>}
                        <button class="deck-row deck-card" type="button" data-deck-card={index} data-card-board={card.board} aria-label={`1× ${card.name}`}>
                          <img src={card.thumbnail} alt="" width="32" height="45" loading="lazy" />
                          <span>{card.name}</span><em>1×</em>
                        </button>
                      </Fragment>
                    ))}
                  </div>
                  <div class="deck-notes" data-deck-panel="notes" hidden>No notes yet.</div>
                </div>
                <div class="deck-footer"><span>Synced</span><span class="deck-primary">+ Add cards</span></div>
                <details class="deck-settings">
                  <summary aria-label="Deck details">•••</summary>
                  <button class="deck-dismiss" type="button" data-deck-close aria-label="Close deck settings"></button>
                  <div class="deck-sheet">
                    <b>Deck details</b>
                    <div class="deck-field"><span>Deck name</span><div>Atraxa Counters</div></div>
                    <div class="deck-field"><span>Format</span><div>Commander <span>▾</span></div></div>
                    <div class="deck-label">Versions <em>New version</em></div>
                    {versions.map((version, index) => (
                      <button class="deck-row version" type="button" data-deck-version aria-pressed={String(index === 0)}>
                        <span class="version-mark" aria-hidden="true"></span>
                        <span class="version-name">{version.name}</span>
                        <span class="version-context">{version.record}<small>100 cards</small></span>
                        <span class="version-menu" aria-hidden="true">•••</span>
                      </button>
                    ))}
                    <button class="deck-primary" type="button" data-deck-close>Save changes</button>
                    <span class="deck-delete">Delete deck</span>
                  </div>
                </details>
                <dialog class="card-focus" aria-labelledby="card-focus-title">
                  <div class="card-focus-header">
                    <b id="card-focus-title"></b>
                    <button type="button" data-card-close aria-label="Close card details" autofocus>Close</button>
                  </div>
                  <div class="card-focus-body" tabindex="0" aria-label="Card information">
                    {demoCards.map((card, index) => (
                      <article data-card-details={index} hidden>
                        <img class="card-focus-image" src={card.image} alt={card.name} width="488" height="680" loading="lazy" />
                        <p class="card-focus-meta">{card.manaCost}</p>
                        <p class="card-focus-meta">{card.typeLine}</p>
                        <p>Color identity: {card.colorIdentity}</p>
                        <p class="card-focus-rules">{card.oracleText}</p>
                        <p class="card-focus-meta">{card.setName} · #{card.collectorNumber} · {card.rarity.charAt(0).toUpperCase() + card.rarity.slice(1)}</p>
                      </article>
                    ))}
                  </div>
                  <div class="card-focus-quantity"></div>
                </dialog>
              </div>
            </div>
          </div>
          <div class="phone second" data-for="connected">
            <div class="screen"><div class="board-holder" data-board="connected"></div></div>
          </div>
        </div>
        <div class="full-bar">
          <button class="quiet" type="button" data-try-close>Close</button>
          <a class="button small" href={APP_LINKS.play}>Play in browser</a>
        </div>
      </div>
    </div>

    <section class="closing">
      <div>
        <h2>Your next game starts here.</h2>
        <GetTheApp />
      </div>
      <figure class="qr">
        <Fragment set:html={qr} />
        <figcaption>Scan to open on your phone</figcaption>
      </figure>
    </section>
  </main>
</Base>

<script>
  import "../stage/page"
</script>

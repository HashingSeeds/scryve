---
import qrcode from "qrcode"

import appIcon from "../../../assets/images/app-icon-ios.png?url"
import GetTheApp from "../components/GetTheApp.astro"
import Base from "../layouts/Base.astro"
import { APP_LINKS } from "../links"
import { demoCards } from "../stage/deck-demo"
import { SITE_SYSTEM_IDS } from "../stage/systems"
import { playSystemRules } from "@/features/game/playSystems"
import { MAX_PLAYERS, MIN_PLAYERS } from "../../../convex/lib/policy"

const qr = await qrcode.toString(new URL("/", Astro.site).href, {
  type: "svg",
  margin: 2,
  color: { dark: "#000000", light: "#ffffff" },
})

const playerCounts = Array.from({ length: MAX_PLAYERS - MIN_PLAYERS + 1 }, (_, i) => MIN_PLAYERS + i)
const versions = [
  { name: "Current", record: "6–1" },
  { name: "Proliferate package", record: "5–3–1" },
  { name: "Budget swap", record: "3–5" },
]
const GITHUB = "https://github.com/HashingSeeds/scryve"
// The History screen's sample games. Deck names are made up so no card names appear.
const history = [
  {
    day: "Saturday, Oct 4",
    games: [
      { system: "pokemon", label: "Pokémon", title: "League Cup, round 3", detail: "Big fire · vs Dragons", result: "W 2–1" },
      { system: "pokemon", label: "Pokémon", title: "League Cup, round 2", detail: "Big fire · vs Psychic box", result: "L 1–2" },
    ],
  },
  {
    day: "Thursday, Oct 2",
    games: [
      { system: "mtg", label: "Magic", title: "Commander pod", detail: "Atraxa Counters · Maya, Devon, Jonas", result: "W" },
      { system: "mtg", label: "Magic", title: "Commander pod", detail: "Atraxa Counters · Maya, Devon, Jonas", result: "L · Devon" },
    ],
  },
  {
    day: "Tuesday, Sep 30",
    games: [
      { system: "ygo", label: "Yu-Gi-Oh!", title: "Locals, round 4", detail: "Fiend combo · vs Snakes", result: "W 2–0" },
      { system: "ygo", label: "Yu-Gi-Oh!", title: "Locals, round 3", detail: "Fiend combo · vs Dragon link", result: "W 2–1" },
      { system: "ygo", label: "Yu-Gi-Oh!", title: "Locals, round 2", detail: "Fiend combo · vs Burn", result: "L 0–2" },
    ],
  },
]
const plans = [
  ["Life counter for 2 to 10 players", "Yes", "Yes"],
  ["Nearby and connected play", "Yes", "Yes"],
  ["Rules and card search", "Yes", "Yes"],
  ["Game history and win rates", "Yes", "Yes"],
  ["Synced decks", "2", "100"],
  ["Versions per deck", "2", "5"],
  ["Compare lists side by side", "No", "Yes"],
  ["Pro seat mark and app icons", "No", "Yes"],
]
// The rules sheet's sample search: Atraxa's deathtouch, quoted from the Comprehensive Rules.
const atraxa = demoCards[0]
const rulesHits = [
  {
    title: "702.2 Deathtouch",
    text: "702.2b A creature with toughness greater than 0 that’s been dealt damage by a source with deathtouch since the last time state-based actions were checked is destroyed as a state-based action.",
  },
  {
    title: "702.2c",
    text: "Any nonzero amount of combat damage assigned to a creature by a source with deathtouch is considered to be lethal damage for the purposes of determining if excess damage is being dealt.",
  },
]
// The store TV's sample event, laid out like the app's store screen. Names are made up.
const pairings = [
  ["1", "Maya", "Devon", "Reported"],
  ["2", "Priya", "Jonas", "Playing"],
  ["3", "Sam", "Alex", "Confirmed"],
  ["4", "Rosa", "Theo", "Playing"],
  ["5", "Nia", "Kai", "Reported"],
  ["6", "Lena", "Omar", "Playing"],
]
const standings = [
  ["1", "Maya", "6", "2-0-0"],
  ["2", "Priya", "6", "2-0-0"],
  ["3", "Sam", "4", "1-0-1"],
  ["4", "Devon", "3", "1-1-0"],
  ["5", "Rosa", "3", "1-1-0"],
  ["6", "Nia", "3", "1-1-0"],
  ["7", "Jonas", "1", "0-1-1"],
]
---

<Base
  title="Scryve: life counter and deck tracker for Magic, Yu-Gi-Oh!, and Pokémon"
  description="A fast life counter for 2 to 10 players with commander damage, Pokémon HP and prizes, nearby games with no signal, offline rules and card search, store events, and deck tracking. Play in your browser or on iPhone and Android."
>
  <header class="header">
    <a class="brand" href="/"><img src={appIcon} alt="" width="30" height="30" />Scryve</a>
    <nav class="header-nav" aria-label="Sections">
      <a href="#features">Features</a>
      <a href="#nearby">No signal</a>
      <a href="#record">History</a>
      <a href="#stores">Stores</a>
      <a href="#pro">Pro</a>
    </nav>
    <div class="header-actions">
      <a class="quiet" href={APP_LINKS.account}>Sign in</a>
      <a class="button small" href={APP_LINKS.play}>Play in browser</a>
    </div>
  </header>

  <main>
    <div class="landing">
      <section class="hero" aria-label="Live life counter">
        <div class="hero-slot" data-hero-slot></div>
      </section>
      <div class="hero-foot">
        <div class="hero-copy">
          <h1>The life counter for Magic, Yu-Gi-Oh!, and Pokémon. <span>Tap to change a total. Really, you try. <svg class="smiley" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M8 14.5c1 1.4 2.4 2 4 2s3-.6 4-2" /><circle class="eye" cx="9" cy="9.5" r="1.2" /><circle class="eye" cx="15" cy="9.5" r="1.2" /></svg></span></h1>
          <div class="hero-games">
            <div class="picker" data-pick="system" role="group" aria-label="Game">
              {SITE_SYSTEM_IDS.map((id) => (
                <button type="button" data-value={id} aria-pressed={String(id === "mtg")}>{playSystemRules(id).shortLabel}</button>
              ))}
            </div>
          </div>
        </div>
        <GetTheApp play={false} />
      </div>
    </div>

    <div class="tour">
      <div class="steps">
        <section data-scene="intro" aria-label="Platforms">
          <div class="step" data-step="intro">
            <div class="step-copy">
              <h2>On the table in seconds.</h2>
              <p>Two to ten players, seated the way you sit. Browser, iPhone, iPad, or Android, and a local game needs no account.</p>
              <div class="picker" data-pick="count" role="group" aria-label="Players">
                {playerCounts.map((count) => (
                  <button type="button" data-value={count} aria-pressed={String(count === 5)}>{count}</button>
                ))}
              </div>
              <div class="picker" data-pick="layout" role="group" aria-label="Layout"></div>
            </div>
          </div>
        </section>

        <section id="features" data-scene="features" aria-label="Features">
          <div class="step" data-step="details">
            <div class="step-copy">
              <div class="demo-copy" data-demo-copy="commander">
                <h2>Commander damage, per opponent.</h2>
                <p>Every seat tracks damage from each commander at the table. At 21 from one commander, that player is out.</p>
              </div>
              <div class="demo-copy" data-demo-copy="yugioh" hidden>
                <h2>Yu-Gi-Oh!, without the math.</h2>
                <p>Tap the calculator in a seat's corner, type the attack, and tap Damage. ½ halves Life Points, rounding up, and your last few changes show under the total. A duel seats two, so the demo does too.</p>
              </div>
              <div class="demo-copy" data-demo-copy="pokemon" hidden>
                <h2>Pokémon, down to the bench.</h2>
                <p>The big number is your Active's HP. Tap a bench Pokémon to damage it. A knockout sends the prizes across the table. Pick your deck and its Pokémon place in one tap.</p>
              </div>
              <div class="demo-controls">
                <div class="picker" data-pick="demo" role="group" aria-label="Demo">
                  <button type="button" data-value="commander" aria-pressed="true">Commander</button>
                  <button type="button" data-value="yugioh" aria-pressed="false">Yu-Gi-Oh!</button>
                  <button type="button" data-value="pokemon" aria-pressed="false">Pokémon</button>
                </div>
                <button class="demo-replay" type="button" data-replay>Replay demo</button>
              </div>
            </div>
          </div>
        </section>

        <section id="nearby" data-scene="nearby" aria-label="Nearby play">
          <div class="step" data-step="nearby">
            <div class="step-copy">
              <h2>No signal? Still one game.</h2>
              <p>Phones on the same Wi-Fi join a nearby game with a code or QR. No internet, no account, and every tap shows on every phone. Tap either one.</p>
              <p class="note">With signal, share a link and play from anywhere.</p>
            </div>
          </div>
        </section>

        <section data-scene="rules" aria-label="Rules and cards">
          <div class="step" data-step="rules">
            <div class="step-copy">
              <h2>Rules and cards at the table.</h2>
              <p>Search the Magic rules or any Magic card from the game menu. Once they download, both answer with no signal.</p>
            </div>
          </div>
        </section>

        <section id="record" data-scene="record" aria-label="History">
          <div class="step" data-step="record">
            <div class="step-copy">
              <h2>Every game, one record.</h2>
              <p>Commander on Thursday, Yu-Gi-Oh! locals on Tuesday, a Pokémon League Cup on Saturday. Every game lands in one history, with a win rate for every deck.</p>
            </div>
          </div>
        </section>

        <section id="pro" data-scene="pro" aria-label="Decks and Scryve Pro">
          <div class="step" data-step="decks">
            <div class="step-copy">
              <h2>Did your last change help?</h2>
              <p>Save a version before you swap cards, and each version keeps its own record. Tap ••• to see them. Share synced decks with a link.</p>
            </div>
          </div>
          <div class="step" data-step="plans">
            <div class="step-copy">
              <h2>Free or Pro</h2>
              <table class="plans">
                <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">Free</th><th scope="col">Scryve Pro</th></tr></thead>
                <tbody>
                  {plans.map(([feature, free, pro]) => (
                    <tr><th scope="row">{feature}</th><td>{free}</td><td>{pro}</td></tr>
                  ))}
                </tbody>
              </table>
              <p class="note">Pro is monthly or yearly. Get it from Account in the app.</p>
            </div>
          </div>
        </section>
      </div>

      <div class="stage" data-stage data-scene="intro" data-step="intro">
        <div class="rig">
          <div class="phone main">
            <div class="screen">
              <div class="scene-screen" data-for="intro features">
                <div class="board-holder" data-board="features"></div>
              </div>
              <div class="scene-screen" data-for="nearby"><div class="board-holder" data-board="nearby"></div></div>
              <div class="scene-screen rules-screen" data-for="rules" role="group" aria-label="Rules">
                <div class="deck-top"><span>Game</span><b>Rules</b><span></span></div>
                <div class="deck-tabs" role="group" aria-label="Search">
                  <button type="button" data-rules-tab="rules" aria-pressed="true">Rules</button>
                  <button type="button" data-rules-tab="cards" aria-pressed="false">Cards</button>
                </div>
                <div class="rules-search">deathtouch</div>
                <div class="rules-list" data-rules-panel="rules">
                  {rulesHits.map((hit) => (
                    <div class="rules-hit"><b>{hit.title}</b><p>{hit.text}</p></div>
                  ))}
                </div>
                <div class="rules-list" data-rules-panel="cards" hidden>
                  <div class="deck-row deck-card">
                    <img src={atraxa.thumbnail} alt="" width="32" height="45" loading="lazy" />
                    <span>{atraxa.name}<small>{atraxa.typeLine}</small></span>
                  </div>
                  <p class="rules-oracle">{atraxa.oracleText}</p>
                </div>
                <div class="hist-record">Saved on this phone</div>
              </div>
              <div class="scene-screen hist" data-for="record" role="group" aria-label="History">
                <div class="deck-top"><span>Account</span><b>History</b><span>Filter</span></div>
                <div class="hist-tabs"><span aria-current="true">All</span><span>Local</span><span>Connected</span></div>
                <div class="hist-list">
                  {history.map(({ day, games }) => (
                    <Fragment>
                      <div class="hist-day">{day}</div>
                      {games.map((game) => (
                        <div class="hist-game">
                          <span class="hist-sys" data-sys={game.system}>{game.label}</span>
                          <span class="hist-text">{game.title}<small>{game.detail}</small></span>
                          <b class={`hist-result ${game.result.startsWith("W") ? "win" : "loss"}`}>{game.result}</b>
                        </div>
                      ))}
                    </Fragment>
                  ))}
                </div>
                <div class="hist-record">7 games · 4W · 3L · 0D</div>
              </div>
              <div class="scene-screen deck" data-for="pro">
                <div class="deck-top"><span>Back</span><b>Deck</b><span>Edit</span></div>
                <div class="deck-content">
                  <div class="deck-name">Atraxa Counters</div>
                  <div class="deck-meta">Magic · Commander · 100 cards</div>
                  <div class="deck-tabs" role="group" aria-label="Deck view">
                    <button type="button" data-deck-tab="cards" aria-pressed="true">Cards</button>
                    <button type="button" data-deck-tab="notes" aria-pressed="false">Notes</button>
                  </div>
                  <div data-deck-panel="cards">
                    <div class="deck-label">Commander <em>Change</em></div>
                    {demoCards.map((card, index) => (
                      <Fragment>
                        {index === 1 && <div class="deck-label">Main deck <em>99</em></div>}
                        <button class="deck-row deck-card" type="button" data-deck-card={index} data-card-board={card.board} aria-label={`1× ${card.name}`}>
                          <img src={card.thumbnail} alt="" width="32" height="45" loading="lazy" />
                          <span>{card.name}</span><em>1×</em>
                        </button>
                      </Fragment>
                    ))}
                  </div>
                  <div class="deck-notes" data-deck-panel="notes" hidden>No notes yet.</div>
                </div>
                <div class="deck-footer"><span>Synced</span><span class="deck-primary">+ Add cards</span></div>
                <details class="deck-settings">
                  <summary aria-label="Deck details">•••</summary>
                  <button class="deck-dismiss" type="button" data-deck-close aria-label="Close deck settings"></button>
                  <div class="deck-sheet">
                    <b>Deck details</b>
                    <div class="deck-field"><span>Deck name</span><div>Atraxa Counters</div></div>
                    <div class="deck-field"><span>Format</span><div>Commander <span>▾</span></div></div>
                    <div class="deck-label">Versions <em>New version</em></div>
                    {versions.map((version, index) => (
                      <button class="deck-row version" type="button" data-deck-version aria-pressed={String(index === 0)}>
                        <span class="version-mark" aria-hidden="true"></span>
                        <span class="version-name">{version.name}</span>
                        <span class="version-context">{version.record}<small>100 cards</small></span>
                        <span class="version-menu" aria-hidden="true">•••</span>
                      </button>
                    ))}
                    <button class="deck-primary" type="button" data-deck-close>Save changes</button>
                    <span class="deck-delete">Delete deck</span>
                  </div>
                </details>
                <dialog class="card-focus" aria-labelledby="card-focus-title">
                  <div class="card-focus-header">
                    <b id="card-focus-title"></b>
                    <button type="button" data-card-close aria-label="Close card details" autofocus>Close</button>
                  </div>
                  <div class="card-focus-body" tabindex="0" aria-label="Card information">
                    {demoCards.map((card, index) => (
                      <article data-card-details={index} hidden>
                        <img class="card-focus-image" src={card.image} alt={card.name} width="488" height="680" loading="lazy" />
                        <p class="card-focus-meta">{card.manaCost}</p>
                        <p class="card-focus-meta">{card.typeLine}</p>
                        <p>Color identity: {card.colorIdentity}</p>
                        <p class="card-focus-rules">{card.oracleText}</p>
                        <p class="card-focus-meta">{card.setName} · #{card.collectorNumber} · {card.rarity.charAt(0).toUpperCase() + card.rarity.slice(1)}</p>
                      </article>
                    ))}
                  </div>
                  <div class="card-focus-quantity"></div>
                </dialog>
              </div>
            </div>
          </div>
          <div class="phone second" data-for="nearby">
            <div class="screen"><div class="board-holder" data-board="nearby"></div></div>
          </div>
        </div>
        <div class="full-bar">
          <button class="quiet" type="button" data-try-close>Close</button>
          <a class="button small" href={APP_LINKS.play}>Play in browser</a>
        </div>
      </div>
    </div>

    <section id="stores" class="stores" aria-labelledby="stores-heading">
      <div class="stores-copy">
        <h2 id="stores-heading">Bring it to your store.</h2>
        <p>Run a Magic event from one phone, with Swiss rounds or Commander pods. Players join with a code and report their own results, and the store TV shows pairings, the round clock, and standings.</p>
        <p class="note">Internet down? Run the event over the store's Wi-Fi, with pairings and results on every phone.</p>
      </div>
      <figure class="tv" aria-label="Store screen">
        <div class="tv-screen">
          <div class="tv-head">
            <div><b>Friday Modern</b><span>Modern · Swiss · Best of 3</span></div>
            <div class="tv-clock"><span>Round 3 of 4</span><b>31:42</b></div>
            <div class="tv-code"><span>Code</span><b>K7Q2</b></div>
          </div>
          <div class="tv-panels">
            <div class="tv-panel">
              <b>Pairings</b>
              {pairings.map(([table, a, b, status]) => (
                <div class="tv-row"><em>{table}</em><span>{a}</span><span>{b}</span><small data-status={status}>{status}</small></div>
              ))}
            </div>
            <div class="tv-panel">
              <b>Standings</b>
              <div class="tv-row tv-label"><em></em><span></span><span>Pts</span><small>W-L-D</small></div>
              {standings.map(([rank, name, points, record]) => (
                <div class="tv-row"><em>{rank}</em><span>{name}</span><span>{points}</span><small>{record}</small></div>
              ))}
            </div>
          </div>
        </div>
      </figure>
    </section>

    <section class="facts" aria-label="Facts">
      <div><b>No account for local play</b><span>Open it and count. Sign in only to sync decks and history, and to play over the internet.</span></div>
      <div><b>No internet needed</b><span>Games, and nearby play over shared Wi-Fi, need no internet. Rules and Magic card search work offline once downloaded.</span></div>
      <div><b>Seven languages</b><span>English, Spanish, French, Japanese, Korean, Hindi, and Arabic, right to left.</span></div>
      <div><b>Open source</b><span>MIT licensed <a href={GITHUB}>on GitHub</a>. Read it, fork it, file a bug.</span></div>
      <div><b>No ads</b><span>Pro pays for the servers. The counter stays free.</span></div>
      <div><b>Straight to the game</b><span>No loading screen, no login screen. Your first tap is a life change.</span></div>
    </section>

    <section class="closing">
      <div>
        <h2>Your next game starts here.</h2>
        <GetTheApp />
      </div>
      <figure class="qr">
        <Fragment set:html={qr} />
        <figcaption>Scan to open on your phone</figcaption>
      </figure>
    </section>
  </main>
</Base>

<script>
  import "../stage/page"
</script>

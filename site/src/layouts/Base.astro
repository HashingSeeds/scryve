---
import favicon from "../../../assets/images/app-icon-web-favicon.png?url"
import shareImage from "../../../assets/images/app-icon-all.png?url"
// Rubik, latin subset, one variable file for every weight (license beside it).
import rubik from "../assets/fonts/Rubik-latin.woff2?url"
import { APP_LINKS, APP_STORE_ID } from "../links"
import "../styles/site.css"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
// `optional` never swaps fonts in after first paint: the file is preloaded, so it is almost
// always ready, and when it isn't the page keeps the system font rather than reflowing.
const fontFace = `@font-face{font-family:"Rubik";src:url("${rubik}") format("woff2");font-weight:300 900;font-display:optional}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <!-- The site is already dark; stops Dark Reader and similar extensions recoloring it. -->
    <meta name="darkreader-lock" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href={shareImage} />
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(shareImage, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href={rubik} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFace}></style>
  </head>
  <body>
    <slot />
    <footer class="footer">
      <nav aria-label="Legal and support">
        <a href={APP_LINKS.privacy}>Privacy</a>
        <a href={APP_LINKS.terms}>Terms</a>
        <a href={APP_LINKS.cookies}>Cookie policy</a>
        <a href={APP_LINKS.support}>Support</a>
        <a href={APP_LINKS.deleteAccount}>Delete account</a>
        <a href={APP_LINKS.gameContentNotices}>Game content notices</a>
      </nav>
      <p>
        Scryve is not affiliated with or endorsed by Wizards of the Coast, Konami, Nintendo, or The
        Pokémon Company. Magic: The Gathering, Yu-Gi-Oh!, and Pokémon are trademarks of their
        respective owners.
      </p>
      <p>
        Scryve is unofficial Fan Content permitted under the Fan Content Policy. Not
        approved/endorsed by Wizards. Portions of the materials used are property of Wizards of the
        Coast. ©Wizards of the Coast LLC.
      </p>
      <p>© {new Date().getFullYear()} Hashing Seeds LLC</p>
    </footer>
  </body>
</html>

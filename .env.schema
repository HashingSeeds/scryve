# Secrets for local scripts. This file holds 1Password references, never values.
# Scripts resolve one key at a time through scripts/secrets.cjs. Expo and Convex
# do not read this file, and package.json points varlock at it alone so it never
# loads .env.local. A value set in the shell wins over the reference.
#
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# @defaultSensitive=true
# @defaultRequired=false
# ---

# Uploads source maps from preview and production native builds.
SENTRY_AUTH_TOKEN=op(op://Scryve/SENTRY_AUTH_TOKEN/password)

# Console key for i18n:translate, used only when the ai-pool key is unavailable.
ANTHROPIC_API_KEY=op(op://Scryve/ANTHROPIC_API_KEY/password)

# Convex preview deploy key for preview:up.
# @type=string(startsWith=preview:)
CONVEX_PREVIEW_DEPLOY_KEY=op(op://Scryve/CONVEX_PREVIEW_DEPLOY_KEY/password)

# Public client configuration. Values here are non-secret and are compiled into
# the app bundle anyway, so they are committed. Per-developer values and local
# secrets belong in .env.local; see README.md.
NODE_ENV=development

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Zm9uZC1tYXJ0aW4tODYuY2xlcmsuYWNjb3VudHMuZGV2JA
EXPO_PUBLIC_INVITE_ORIGIN=https://scryve.sow.care

# Convex deployments are per developer. Set CONVEX_DEPLOYMENT, EXPO_PUBLIC_CONVEX_URL,
# and EXPO_PUBLIC_CONVEX_SITE_URL in the ignored .env.local. See .env.example.

# Backend-only values (CLERK_JWT_ISSUER_DOMAIN, CLERK_SECRET_KEY,
# CLERK_WEBHOOK_SIGNING_SECRET, RESEND_API_KEY, MODERATION_ALERT_*) are read by
# convex/ code running on the deployment. Set them per deployment with
# `npx convex env set`; copies here are never read.

EXPO_PUBLIC_REVENUECAT_API_KEY=test_igXKrqWhYHBBmyzMiKHsrkSDcDv

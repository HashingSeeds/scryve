import { StyleProp, ViewStyle } from "react-native"

import { Screen } from "@/components/Screen"
import { Text } from "@/components/Text"

export interface <%= props.pascalCaseName %>ScreenProps {
  contentContainerStyle?: StyleProp<ViewStyle>
}

export function <%= props.pascalCaseName %>Screen(props: <%= props.pascalCaseName %>ScreenProps) {
  const { contentContainerStyle: $contentContainerStyleOverride } = props

  return (
    <Screen preset="scroll" contentContainerStyle={[$root, $contentContainerStyleOverride]}>

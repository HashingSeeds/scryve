# Public client configuration only. Never place Clerk secret keys or Convex deploy keys here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_CONVEX_URL=https://replace-me.convex.cloud
CONVEX_DEPLOYMENT=dev:replace-me
EXPO_PUBLIC_CONVEX_SITE_URL=https://replace-me.convex.site
EXPO_PUBLIC_CLERK_SIGN_IN_URL=https://replace-me.accounts.dev/sign-in

# Sentry DSN for crash reporting and error tracking
EXPO_PUBLIC_SENTRY_DSN=https://replace-me@o4507118738669568.ingest.us.sentry.io/4511870328635392

# HTTPS origin used in share links. Configure native universal/app-link association externally.
EXPO_PUBLIC_INVITE_ORIGIN=https://scryve.sow.care

# RevenueCat public SDK keys are safe to include in the client. Use the shared Test Store key
# during development, then configure platform-specific public keys for production builds.
EXPO_PUBLIC_REVENUECAT_API_KEY=test_replace_me
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_replace_me
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_replace_me
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=rcb_replace_me

# Server-only RevenueCat settings, configured in each Convex deployment dashboard:
# Subscriber lookup accepts the Test Store SDK key for QA or a v1 secret API key.
# REVENUECAT_SECRET_API_KEY=sk_replace_me
# REVENUECAT_WEBHOOK_AUTH=Bearer replace_with_a_random_secret
# REVENUECAT_ENVIRONMENT=SANDBOX
# Use PRODUCTION for the production backend. Configure a RevenueCat webhook at:
# https://your-convex-site.convex.site/revenuecat/webhooks
# Its Authorization header must exactly match REVENUECAT_WEBHOOK_AUTH.

# Set this separately in each Convex deployment dashboard (do not expose it to Expo):
# CLERK_FRONTEND_API_URL=https://your-clerk-instance.clerk.accounts.dev
# CLERK_SECRET_KEY=sk_live_replace_me
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# Configure Clerk user.created and user.updated events to POST to:
# https://your-convex-site.convex.site/clerk/webhooks

# Player-report alerts. Without all three, reports are still filed and acted on; only the
# notification email is skipped. Set these in each Convex deployment dashboard:
# RESEND_API_KEY=re_replace_me
# MODERATION_ALERT_TO=support@sowinghope.how
# MODERATION_ALERT_FROM=moderation@sow.care

# Optional product analytics. Leave unset to disable PostHog in this build.
# Use a separate development project when measuring or testing. Player opt-in is still required.
# EXPO_PUBLIC_POSTHOG_KEY=phc_replace_me
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

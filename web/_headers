# Cloudflare Pages response headers. iOS reads the association file as JSON, but it has no
# extension, so Pages would otherwise serve it as application/octet-stream.
/.well-known/apple-app-site-association
  Content-Type: application/json

# The full CSP is report-only: Clerk, Turnstile and RevenueCat's Stripe checkout load code at
# runtime that the local check cannot reach, so violations show in the console before they block.
# The script hashes are the inline scripts in public/index.html and site/src/pages/preview.astro;
# edit either and its hash changes. *.clerk.accounts.dev and *.convex.cloud cover PR previews.
# frame-ancestors is ignored in report-only policies, so the enforced CSP carries it.
/*
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-sBMZVAqxhm1vpnw1Zu4lXlF6iD+7wJztkq37omJs6xE=' 'sha256-hEsmI69+67sVJsl7O8KNL75e4fZNtXMLrGwO5WTHYCQ=' https://clerk.scryve.sow.care https://*.clerk.accounts.dev https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' data: blob: https://*.convex.cloud wss://*.convex.cloud https://clerk.scryve.sow.care https://*.clerk.accounts.dev https://clerk-telemetry.com https://p.sow.care https://*.ingest.us.sentry.io https://api.revenuecat.com https://api.stripe.com; frame-src https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
